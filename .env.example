# Database
DATABASE_URL="postgresql://mesh:mesh@localhost:5432/mesh?schema=public"
TEST_DATABASE_URL="postgresql://mesh:mesh@localhost:5432/mesh_test?schema=public"

# Providers. Local development must boot with all providers set to "mock".
MESSAGING_PROVIDER="mock"        # mock | photon | web_fallback
AI_PROVIDER="mock"               # mock | openai
VIDEO_PROVIDER="mock"            # mock
VERIFICATION_PROVIDER="mock"     # mock

# Agent messaging entry point. Leave empty until a real number is provisioned;
# the website then shows a "not open yet" state instead of inventing a number.
AGENT_PHONE_NUMBER=""
NEXT_PUBLIC_AGENT_PHONE_NUMBER=""

# Origin the Agent uses when it sends a video link over messaging.
APP_BASE_URL="http://localhost:3000"

# Photon (unverified contract — adapter stays disabled until confirmed)
PHOTON_API_BASE_URL=""
PHOTON_API_KEY=""
PHOTON_WEBHOOK_SECRET=""

# OpenAI (only used when AI_PROVIDER=openai and the user granted
# THIRD_PARTY_PROCESSING consent)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Dev-only surfaces (/dev/chat and its API). Never enable in production.
ENABLE_DEV_CHAT="true"

# Allow real users to be introduced to seeded demo profiles (demo-only convenience).
MATCH_WITH_DEMO_USERS="true"
