# ---- 基础 ----
PORT=8080
AUTH_MODE=dev            # dev | otp（otp 需接短信网关，见 src/auth.ts）
AUTH_SECRET=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8080

# ---- 数据库 ----
DATABASE_URL=postgres://mesh:mesh@localhost:5432/mesh
# npm test 用的独立库（不存在会自动创建，每个用例前清空）
TEST_DATABASE_URL=postgres://mesh:mesh@localhost:5432/mesh_test
# docker compose 暴露到本机的端口（本机已占用 5432/6379 时改这里，并同步改上面两个 URL）
DB_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- LLM（DeepSeek，OpenAI 兼容）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 微信服务号（模板消息主通道，stub）----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_RECOMMEND=
WECHAT_TEMPLATE_VIDEO=

# ---- 短信网关（兜底通道，stub）----
SMS_PROVIDER=aliyun        # aliyun | tencent
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---- TRTC 视频（stub，内测期可用体验版）----
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
