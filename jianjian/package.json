{
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "description": "MESH AI 生产版后端骨架：单体 API + PostgreSQL + Redis",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "mesh-backend",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/db/*.sql dist/db/",
    "dev": "tsx watch src/index.ts",
    "job:weekly": "tsx src/jobs/weekly.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
